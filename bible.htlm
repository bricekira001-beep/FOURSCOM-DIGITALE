    {id:"Os",nom:"Osée",chapters:14},{id:"Jl",nom:"Joël",chapters:3},{id:"Am",nom:"Amos",chapters:9},
    {id:"Ab",nom:"Abdias",chapters:1},{id:"Jon",nom:"Jonas",chapters:4},{id:"Mi",nom:"Michée",chapters:7},
    {id:"Na",nom:"Nahoum",chapters:3},{id:"Ha",nom:"Habacuc",chapters:3},{id:"So",nom:"Sophonie",chapters:3},
    {id:"Ag",nom:"Aggée",chapters:2},{id:"Za",nom:"Zacharie",chapters:14},{id:"Ml",nom:"Malachie",chapters:4}
  ],
  nt: [
    {id:"Mt",nom:"Matthieu",chapters:28},{id:"Mc",nom:"Marc",chapters:16},{id:"Lc",nom:"Luc",chapters:24},
    {id:"Jn",nom:"Jean",chapters:21},{id:"Ac",nom:"Actes",chapters:28},{id:"Rm",nom:"Romains",chapters:16},
    {id:"1Co",nom:"1 Corinthiens",chapters:16},{id:"2Co",nom:"2 Corinthiens",chapters:13},{id:"Ga",nom:"Galates",chapters:6},
    {id:"Ep",nom:"Éphésiens",chapters:6},{id:"Ph",nom:"Philippiens",chapters:4},{id:"Col",nom:"Colossiens",chapters:4},
    {id:"1Th",nom:"1 Thessaloniciens",chapters:5},{id:"2Th",nom:"2 Thessaloniciens",chapters:3},{id:"1Tm",nom:"1 Timothée",chapters:6},
    {id:"2Tm",nom:"2 Timothée",chapters:4},{id:"Tt",nom:"Tite",chapters:3},{id:"Phm",nom:"Philémon",chapters:1},
    {id:"Hé",nom:"Hébreux",chapters:13},{id:"Jc",nom:"Jacques",chapters:5},{id:"1P",nom:"1 Pierre",chapters:5},
    {id:"2P",nom:"2 Pierre",chapters:3},{id:"1Jn",nom:"1 Jean",chapters:5},{id:"2Jn",nom:"2 Jean",chapters:1},
    {id:"3Jn",nom:"3 Jean",chapters:1},{id:"Jd",nom:"Jude",chapters:1},{id:"Ap",nom:"Apocalypse",chapters:22}
  ]

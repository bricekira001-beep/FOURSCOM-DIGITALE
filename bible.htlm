<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bible Interactive — FOURCOM DIGITAL</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Crimson+Pro:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
<style>
  :root {
    --red: #D9152B; --blue: #0066B3; --yellow: #FFD23C; --purple: #5E3388;
    --bg: #F7F8FB; --surface: #F2F4F8; --white: #FFFFFF; --text: #050505; --text-muted: #243B55;
    --border: rgba(0,102,179,0.11); --border-strong: rgba(0,102,179,0.22);
    --gold: #FFD23C; --radius: 12px; --font: 'Poppins', sans-serif; --font-bible: 'Crimson Pro', Georgia, serif;
    --card-bg: rgba(255,255,255,0.92);
    --nav-bg: rgba(247,248,251,0.97);
    --sidebar-w: 280px;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { font-family:var(--font); background:var(--bg); color:var(--text); line-height:1.6; }

  /* TOP BAR */
  .topbar {
    position:sticky; top:0; z-index:100;
    background:var(--nav-bg); backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
    display:flex; align-items:center; gap:12px; padding:10px 20px;
    box-shadow:0 4px 20px rgba(0,0,0,0.05);
  }
  .topbar-logo { font-weight:900; font-size:1rem; color:var(--red); white-space:nowrap; }
  .topbar-title { font-size:0.85rem; color:var(--text-muted); font-weight:600; }
  .topbar-divider { width:1px; height:24px; background:var(--border-strong); }
  .search-wrap { flex:1; position:relative; max-width:480px; }
  .search-wrap input {
    width:100%; padding:9px 16px 9px 40px;
    border:1px solid var(--border-strong); border-radius:24px;
    background:var(--white); font-family:var(--font); font-size:0.85rem; color:var(--text);
    outline:none; transition:border-color 0.2s, box-shadow 0.2s;
  }
  .search-wrap input:focus { border-color:var(--blue); box-shadow:0 0 0 3px rgba(0,102,179,0.1); }
  .search-wrap .si { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:1rem; }
  .search-results {
    position:absolute; top:calc(100% + 6px); left:0; right:0;
    background:var(--white); border:1px solid var(--border-strong); border-radius:14px;
    box-shadow:0 16px 44px rgba(0,0,0,0.12); z-index:200; max-height:320px; overflow-y:auto; display:none;
  }
  .search-results.open { display:block; }
  .sr-item { padding:10px 16px; cursor:pointer; border-bottom:1px solid var(--border); font-size:0.83rem; transition:background 0.15s; }
  .sr-item:hover { background:var(--surface); }
  .sr-item:last-child { border-bottom:none; }
  .sr-ref { color:var(--blue); font-weight:700; margin-right:8px; }
  .topbar-actions { display:flex; gap:8px; margin-left:auto; }
  .icon-btn {
    width:36px; height:36px; border-radius:50%; border:1px solid var(--border-strong);
    background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center;
    color:var(--text-muted); font-size:1.1rem; transition:all 0.2s; font-family:var(--font);
  }
  .icon-btn:hover { background:var(--blue); color:var(--white); border-color:var(--blue); }
  .icon-btn.active { background:var(--yellow); color:var(--text); border-color:var(--yellow); }

  /* LAYOUT */
  .app { display:flex; height:calc(100vh - 57px); }

  /* SIDEBAR */
  .sidebar {
    width:var(--sidebar-w); flex-shrink:0; border-right:1px solid var(--border);
    background:var(--white); display:flex; flex-direction:column; overflow:hidden;
    transition:width 0.3s; position:relative;
  }
  .sidebar.collapsed { width:0; }
  .sidebar-inner { width:var(--sidebar-w); flex:1; display:flex; flex-direction:column; overflow:hidden; }
  .sidebar-tabs { display:flex; border-bottom:1px solid var(--border); }
  .stab {
    flex:1; padding:10px 4px; border:none; background:transparent; cursor:pointer;
    font-family:var(--font); font-size:0.72rem; font-weight:700; color:var(--text-muted);
    border-bottom:2px solid transparent; transition:all 0.2s; text-align:center;
  }
  .stab.active { color:var(--blue); border-bottom-color:var(--blue); }
  .stab:hover { color:var(--blue); }
  .sidebar-body { flex:1; overflow-y:auto; padding:12px; }
  .sidebar-body::-webkit-scrollbar { width:4px; }
  .sidebar-body::-webkit-scrollbar-thumb { background:var(--border-strong); border-radius:2px; }

  /* TESTAMENT / BOOK LIST */
  .testament-group { margin-bottom:1rem; }
  .testament-label {
    font-size:0.68rem; font-weight:900; letter-spacing:0.1em; color:var(--red);
    text-transform:uppercase; padding:6px 4px 4px; position:sticky; top:-12px;
    background:var(--white); z-index:1;
  }
  .book-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:4px; }
  .book-btn {
    padding:5px 3px; border:1px solid var(--border); border-radius:8px; background:var(--surface);
    cursor:pointer; font-family:var(--font); font-size:0.66rem; font-weight:700; color:var(--text-muted);
    text-align:center; transition:all 0.18s; line-height:1.2;
  }
  .book-btn:hover { background:rgba(0,102,179,0.1); border-color:var(--blue); color:var(--blue); }
  .book-btn.active { background:var(--blue); border-color:var(--blue); color:var(--white); }

  /* CHAPTER PICKER */
  .chapter-grid { display:grid; grid-template-columns:repeat(5, 1fr); gap:5px; }
  .ch-btn {
    aspect-ratio:1; border:1px solid var(--border); border-radius:8px; background:var(--surface);
    cursor:pointer; font-family:var(--font); font-size:0.78rem; font-weight:700; color:var(--text-muted);
    transition:all 0.18s; display:flex; align-items:center; justify-content:center;
  }
  .ch-btn:hover { background:rgba(0,102,179,0.1); border-color:var(--blue); color:var(--blue); }
  .ch-btn.active { background:var(--blue); border-color:var(--blue); color:var(--white); }
  .ch-btn.read { background:rgba(255,210,60,0.2); border-color:rgba(255,210,60,0.5); }

  /* FAVORITES IN SIDEBAR */
  .fav-item { padding:9px 8px; border:1px solid var(--border); border-radius:10px; background:var(--surface); margin-bottom:6px; cursor:pointer; transition:all 0.18s; }
  .fav-item:hover { border-color:var(--blue); background:rgba(0,102,179,0.05); }
  .fav-ref { font-size:0.72rem; color:var(--blue); font-weight:800; margin-bottom:2px; }
  .fav-text { font-family:var(--font-bible); font-size:0.82rem; color:var(--text-muted); line-height:1.4; }

  /* HISTORY ITEM */
  .hist-item { display:flex; align-items:center; gap:8px; padding:8px 8px; border:1px solid var(--border); border-radius:10px; background:var(--surface); margin-bottom:6px; cursor:pointer; transition:all 0.18s; }
  .hist-item:hover { border-color:var(--blue); }
  .hist-ref { font-size:0.78rem; color:var(--blue); font-weight:800; flex:1; }
  .hist-time { font-size:0.65rem; color:var(--text-muted); }

  /* READING PLAN */
  .plan-item { padding:10px 10px; border:1px solid var(--border); border-radius:12px; background:var(--surface); margin-bottom:8px; cursor:pointer; transition:all 0.18s; }
  .plan-item:hover { border-color:var(--blue); }
  .plan-item.done { background:rgba(255,210,60,0.15); border-color:rgba(255,210,60,0.5); }
  .plan-day { font-size:0.68rem; font-weight:900; color:var(--purple); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:3px; }
  .plan-ref { font-size:0.82rem; font-weight:800; color:var(--text); }
  .plan-desc { font-size:0.72rem; color:var(--text-muted); margin-top:2px; }

  /* MAIN CONTENT */
  .main { flex:1; display:flex; flex-direction:column; overflow:hidden; }
  .toolbar {
    background:var(--white); border-bottom:1px solid var(--border);
    display:flex; align-items:center; gap:10px; padding:10px 20px; flex-wrap:wrap;
  }
  .nav-btn {
    padding:7px 14px; border:1px solid var(--border-strong); border-radius:20px; background:transparent;
    cursor:pointer; font-family:var(--font); font-size:0.8rem; font-weight:700; color:var(--text-muted);
    transition:all 0.18s; display:flex; align-items:center; gap:5px;
  }
  .nav-btn:hover { background:var(--blue); color:var(--white); border-color:var(--blue); }
  .current-ref { font-family:var(--font); font-size:1rem; font-weight:900; color:var(--text); flex:1; text-align:center; }
  .version-sel {
    padding:6px 12px; border:1px solid var(--border-strong); border-radius:20px;
    background:var(--white); font-family:var(--font); font-size:0.78rem; font-weight:700;
    color:var(--text); cursor:pointer; outline:none;
  }
  .font-controls { display:flex; align-items:center; gap:4px; }
  .font-btn {
    width:30px; height:30px; border-radius:50%; border:1px solid var(--border-strong);
    background:transparent; cursor:pointer; font-family:var(--font); font-weight:800;
    color:var(--text-muted); transition:all 0.18s; display:flex; align-items:center; justify-content:center;
  }
  .font-btn:hover { background:var(--blue); color:var(--white); border-color:var(--blue); }

  /* READER */
  .reader { flex:1; overflow-y:auto; padding:40px 60px; background:var(--bg); }
  .reader::-webkit-scrollbar { width:5px; }
  .reader::-webkit-scrollbar-thumb { background:var(--border-strong); border-radius:3px; }

  .verset-du-jour-banner {
    background:linear-gradient(135deg, rgba(217,21,43,0.08), rgba(0,102,179,0.08));
    border:1px solid var(--border-strong); border-radius:18px; padding:22px 28px;
    margin-bottom:32px; text-align:center; position:relative; overflow:hidden;
  }
  .vdj-label { font-size:0.72rem; font-weight:900; letter-spacing:0.1em; color:var(--red); text-transform:uppercase; margin-bottom:10px; }
  .vdj-text { font-family:var(--font-bible); font-size:1.5rem; color:var(--text); font-style:italic; line-height:1.5; margin-bottom:10px; }
  .vdj-ref { font-size:0.82rem; color:var(--blue); font-weight:800; }
  .vdj-decoration { position:absolute; top:-20px; right:-20px; width:100px; height:100px; border-radius:50%; border:30px solid var(--yellow); opacity:0.2; }

  .chapter-header { margin-bottom:28px; }
  .chapter-book { font-size:0.75rem; font-weight:900; color:var(--purple); text-transform:uppercase; letter-spacing:0.12em; margin-bottom:6px; }
  .chapter-num { font-family:var(--font-bible); font-size:2.8rem; color:var(--text); font-weight:600; line-height:1; }

  .verse-list { max-width:720px; }
  .verse-row {
    display:flex; gap:16px; padding:6px 0; position:relative; cursor:pointer;
    border-radius:10px; transition:background 0.18s; padding:8px 10px; margin:0 -10px;
  }
  .verse-row:hover { background:rgba(0,102,179,0.04); }
  .verse-row.selected { background:rgba(255,210,60,0.18); border-radius:10px; }
  .verse-row.highlighted { background:rgba(217,21,43,0.07); border-left:3px solid var(--red); padding-left:13px; margin-left:-7px; }
  .verse-row.favorited { background:rgba(255,210,60,0.15); }
  .verse-num { font-family:var(--font); font-size:0.72rem; font-weight:900; color:var(--red); min-width:24px; margin-top:4px; flex-shrink:0; }
  .verse-text { font-family:var(--font-bible); color:var(--text); line-height:1.8; flex:1; }
  .verse-note { margin-top:6px; font-size:0.8rem; color:var(--text-muted); background:rgba(94,51,136,0.08); border-left:3px solid var(--purple); padding:6px 10px; border-radius:0 8px 8px 0; font-style:italic; }

  /* VERSE ACTIONS POPUP */
  .verse-popup {
    position:fixed; background:var(--white); border:1px solid var(--border-strong);
    border-radius:14px; box-shadow:0 16px 44px rgba(0,0,0,0.15); z-index:300;
    display:none; padding:8px; min-width:180px;
  }
  .verse-popup.open { display:block; animation:popIn 0.18s ease; }
  @keyframes popIn { from{opacity:0;transform:scale(0.92)} to{opacity:1;transform:scale(1)} }
  .vp-btn {
    display:flex; align-items:center; gap:10px; width:100%; padding:9px 12px;
    border:none; background:transparent; cursor:pointer; font-family:var(--font);
    font-size:0.82rem; font-weight:700; color:var(--text); border-radius:8px; transition:background 0.15s;
    text-align:left;
  }
  .vp-btn:hover { background:var(--surface); }
  .vp-btn i { font-size:1rem; color:var(--blue); }

  /* NOTE MODAL */
  .modal-overlay { position:fixed; inset:0; background:rgba(5,5,5,0.55); backdrop-filter:blur(8px); z-index:400; display:none; align-items:center; justify-content:center; padding:20px; }
  .modal-overlay.open { display:flex; }
  .modal-box { background:var(--white); border-radius:20px; padding:24px; max-width:480px; width:100%; box-shadow:0 24px 64px rgba(0,0,0,0.22); animation:modalIn 0.25s ease; }
  @keyframes modalIn { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
  .modal-title { font-size:1.1rem; font-weight:900; margin-bottom:16px; color:var(--text); }
  .modal-ref { font-size:0.78rem; color:var(--blue); font-weight:800; margin-bottom:12px; }
  .modal-verse-text { font-family:var(--font-bible); font-size:1rem; color:var(--text-muted); font-style:italic; line-height:1.6; margin-bottom:16px; padding:12px; background:var(--surface); border-radius:10px; }
  .modal-box textarea {
    width:100%; border:1px solid var(--border-strong); border-radius:12px; padding:12px;
    font-family:var(--font); font-size:0.88rem; color:var(--text); resize:vertical;
    min-height:100px; outline:none; background:var(--bg); line-height:1.6;
  }
  .modal-box textarea:focus { border-color:var(--blue); box-shadow:0 0 0 3px rgba(0,102,179,0.1); }
  .modal-footer { display:flex; gap:10px; margin-top:16px; justify-content:flex-end; }
  .btn-cancel { padding:10px 20px; border:1px solid var(--border-strong); border-radius:10px; background:transparent; cursor:pointer; font-family:var(--font); font-weight:700; color:var(--text-muted); }
  .btn-save { padding:10px 20px; border:none; border-radius:10px; background:var(--blue); color:var(--white); cursor:pointer; font-family:var(--font); font-weight:800; box-shadow:0 8px 20px rgba(0,102,179,0.2); }

  /* AUDIO PLAYER */
  .audio-bar {
    background:var(--white); border-top:1px solid var(--border); padding:12px 24px;
    display:none; align-items:center; gap:14px;
  }
  .audio-bar.active { display:flex; }
  .audio-play-btn {
    width:40px; height:40px; border-radius:50%; background:var(--yellow); border:none;
    cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1.1rem;
    flex-shrink:0; transition:transform 0.18s;
  }
  .audio-play-btn:hover { transform:scale(1.08); }
  .audio-info { flex:1; }
  .audio-ref-text { font-size:0.8rem; font-weight:800; color:var(--text); margin-bottom:4px; }
  .audio-progress-wrap { background:rgba(0,102,179,0.12); border-radius:999px; height:4px; cursor:pointer; position:relative; }
  .audio-progress-fill { height:100%; background:linear-gradient(90deg,var(--red),var(--blue)); border-radius:999px; transition:width 0.3s; }
  .audio-time { font-size:0.72rem; color:var(--text-muted); white-space:nowrap; }
  .audio-close { background:none; border:none; cursor:pointer; color:var(--text-muted); font-size:1.1rem; padding:4px; }

  /* TOAST */
  .toast { position:fixed; bottom:24px; right:24px; background:rgba(5,5,5,0.86); color:var(--white); padding:12px 18px; border-radius:14px; font-size:0.85rem; border-left:4px solid var(--yellow); z-index:500; transform:translateY(80px) scale(0.95); opacity:0; transition:all 0.3s; box-shadow:0 14px 40px rgba(0,0,0,0.22); }
  .toast.show { transform:translateY(0) scale(1); opacity:1; }

  /* HIGHLIGHTS PICKER */
  .hl-picker { display:flex; gap:6px; align-items:center; padding:4px 0; }
  .hl-dot { width:20px; height:20px; border-radius:50%; cursor:pointer; border:2px solid transparent; transition:transform 0.15s; flex-shrink:0; }
  .hl-dot:hover { transform:scale(1.2); }
  .hl-dot.active { border-color:var(--text); }
  .hl-clear { font-size:0.72rem; color:var(--text-muted); cursor:pointer; font-weight:700; border:none; background:none; font-family:var(--font); }
  .hl-clear:hover { color:var(--red); }

  /* MOBILE */
  @media(max-width:768px) {
    :root { --sidebar-w: 100vw; }
    .sidebar { position:fixed; top:57px; bottom:0; left:0; z-index:90; width:0; }
    .sidebar:not(.collapsed) { width:var(--sidebar-w); }
    .reader { padding:24px 20px; }
    .toolbar { padding:8px 12px; }
    .current-ref { font-size:0.85rem; }
    .topbar { padding:8px 12px; gap:8px; }
  }

  /* DARK MODE */
  .dark-mode {
    --bg: #080E1A; --surface: #0E1826; --white: #111C2E; --text: #E8F0FA; --text-muted: #8BA4C0;
    --border: rgba(100,160,255,0.13); --border-strong: rgba(100,160,255,0.22);
    --nav-bg: rgba(8,14,26,0.97);
  }
  .dark-mode .search-results { background:#111C2E; }

  /* ANIMATIONS */
  @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
  .verse-row { animation:fadeUp 0.35s ease both; }
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <span class="topbar-logo">✦ BIBLE</span>
  <div class="topbar-divider"></div>
  <span class="topbar-title">Lecture interactive</span>
  <div class="search-wrap">
    <i class="bx bx-search si"></i>
    <input type="text" id="searchInput" placeholder='Chercher un verset, mot ou référence (ex: Jean 3:16)...' oninput="handleSearch(this.value)" onblur="setTimeout(()=>closeSearch(),200)">
    <div class="search-results" id="searchResults"></div>
  </div>
  <div class="topbar-actions">
    <button class="icon-btn" onclick="toggleDark()" title="Mode sombre"><i class="bx bx-moon"></i></button>
    <button class="icon-btn" onclick="toggleSidebar()" id="sidebarBtn" title="Menu"><i class="bx bx-menu"></i></button>
  </div>
</div>

<!-- LAYOUT -->
<div class="app">
  <!-- SIDEBAR -->
  <div class="sidebar" id="sidebar">
    <div class="sidebar-inner">
      <div class="sidebar-tabs">
        <button class="stab active" onclick="showSidePanel('books',this)">Livres</button>
        <button class="stab" onclick="showSidePanel('favs',this)">Favoris</button>
        <button class="stab" onclick="showSidePanel('history',this)">Historique</button>
        <button class="stab" onclick="showSidePanel('plan',this)">Plan</button>
      </div>
      <div class="sidebar-body" id="sideBody"></div>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">
    <!-- TOOLBAR -->
    <div class="toolbar">
      <button class="nav-btn" onclick="navigate(-1)"><i class="bx bx-chevron-left"></i> Préc.</button>
      <span class="current-ref" id="currentRef">Jean 3</span>
      <button class="nav-btn" onclick="navigate(1)">Suiv. <i class="bx bx-chevron-right"></i></button>
      <select class="version-sel" id="versionSel" onchange="changeVersion(this.value)">
        <option value="ls">Louis Segond</option>
        <option value="darby">Darby</option>
        <option value="neg">Nouvelle Édition Genève</option>
        <option value="bfc">Bible en Français Courant</option>
      </select>
      <div class="font-controls">
        <button class="font-btn" onclick="adjustFont(-1)" style="font-size:0.7rem">A-</button>
        <button class="font-btn" onclick="adjustFont(1)" style="font-size:0.95rem">A+</button>
      </div>
      <button class="icon-btn" id="audioToggleBtn" onclick="openAudioPlayer()" title="Écouter"><i class="bx bx-volume-full"></i></button>
    </div>

    <!-- READER -->
    <div class="reader" id="reader"></div>

    <!-- AUDIO PLAYER -->
    <div class="audio-bar" id="audioBar">
      <button class="audio-play-btn" onclick="toggleAudio()" id="audioBtn"><i class="bx bx-play" id="audioIcon"></i></button>
      <div class="audio-info">
        <div class="audio-ref-text" id="audioRefText">Jean 3 — Louis Segond</div>
        <div class="audio-progress-wrap" id="audioPW" onclick="seekAudio(event,this)">
          <div class="audio-progress-fill" id="audioPF" style="width:0%"></div>
        </div>
      </div>
      <span class="audio-time" id="audioTimeTxt">0:00</span>
      <button class="audio-close" onclick="closeAudio()"><i class="bx bx-x"></i></button>
    </div>
  </div>
</div>

<!-- VERSE POPUP -->
<div class="verse-popup" id="versePopup">
  <div class="hl-picker" style="padding:4px 12px 8px; border-bottom:1px solid var(--border); margin-bottom:4px;">
    <span style="font-size:0.7rem;color:var(--text-muted);font-weight:800;margin-right:4px">Surligner:</span>
    <span class="hl-dot" style="background:#FFD23C" onclick="highlightVerse('yellow')" title="Jaune"></span>
    <span class="hl-dot" style="background:#7DD9B3" onclick="highlightVerse('green')" title="Vert"></span>
    <span class="hl-dot" style="background:#90BDFF" onclick="highlightVerse('blue')" title="Bleu"></span>
    <span class="hl-dot" style="background:#F99090" onclick="highlightVerse('red')" title="Rouge"></span>
    <button class="hl-clear" onclick="removeHighlight()">Effacer</button>
  </div>
  <button class="vp-btn" onclick="copyVerse()"><i class="bx bx-copy"></i> Copier</button>
  <button class="vp-btn" onclick="shareVerse()"><i class="bx bx-share"></i> Partager</button>
  <button class="vp-btn" onclick="toggleFavorite()"><i class="bx bx-heart" id="favBtnIcon"></i> <span id="favBtnText">Ajouter aux favoris</span></button>
  <button class="vp-btn" onclick="openNote()"><i class="bx bx-note"></i> Ajouter une note</button>
  <button class="vp-btn" onclick="listenVerse()"><i class="bx bx-volume-full"></i> Écouter</button>
</div>

<!-- NOTE MODAL -->
<div class="modal-overlay" id="noteModal">
  <div class="modal-box">
    <div class="modal-title"><i class="bx bx-note" style="color:var(--purple)"></i> Note personnelle</div>
    <div class="modal-ref" id="noteRef"></div>
    <div class="modal-verse-text" id="noteVerseText"></div>
    <textarea id="noteTextarea" placeholder="Écrivez votre note, réflexion ou commentaire..."></textarea>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeNote()">Annuler</button>
      <button class="btn-save" onclick="saveNote()">Enregistrer ✦</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
// ════════════════════════════════
// BIBLE DATA (real verses)
// ════════════════════════════════
const VERSIONS = {

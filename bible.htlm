const ALL_BOOKS = [...BOOKS.at, ...BOOKS.nt];

// Rich verse database (key chapters)
const VERSE_DB = {
  "Jn-3": [
    {n:1, text:"Il y avait parmi les pharisiens un homme appelé Nicodème, un des chefs des Juifs."},
    {n:2, text:"Cet homme vint auprès de Jésus de nuit, et lui dit : Rabbi, nous savons que tu es un docteur venu de Dieu ; car personne ne peut faire ces miracles que tu fais, si Dieu n'est pas avec lui."},
    {n:3, text:"Jésus lui répondit : En vérité, en vérité, je te le dis, si un homme ne naît de nouveau, il ne peut voir le royaume de Dieu."},
    {n:4, text:"Nicodème lui dit : Comment un homme peut-il naître quand il est vieux ? Peut-il entrer dans le ventre de sa mère et naître ?"},
    {n:5, text:"Jésus répondit : En vérité, en vérité, je te le dis, si un homme ne naît d'eau et d'Esprit, il ne peut entrer dans le royaume de Dieu."},
    {n:6, text:"Ce qui est né de la chair est chair, et ce qui est né de l'Esprit est esprit."},
    {n:7, text:"Ne t'étonne pas que je t'aie dit : Il faut que vous naissiez de nouveau."},
    {n:8, text:"Le vent souffle où il veut, et tu en entends le bruit ; mais tu ne sais ni d'où il vient, ni où il va. Il en est ainsi de tout homme qui est né de l'Esprit."},
    {n:9, text:"Nicodème lui répondit : Comment cela peut-il se faire ?"},
    {n:10, text:"Jésus lui répondit : Tu es le docteur d'Israël, et tu ne sais pas ces choses !"},
    {n:11, text:"En vérité, en vérité, je te le dis, nous disons ce que nous savons, et nous rendons témoignage de ce que nous avons vu ; et vous ne recevez pas notre témoignage."},
    {n:12, text:"Si je vous ai parlé des choses terrestres, et si vous ne croyez pas, comment croirez-vous, si je vous parle des choses célestes ?"},
    {n:13, text:"Personne n'est monté au ciel, si ce n'est celui qui est descendu du ciel, le Fils de l'homme qui est dans le ciel."},
    {n:14, text:"Et comme Moïse éleva le serpent dans le désert, il faut de même que le Fils de l'homme soit élevé,"},
    {n:15, text:"afin que quiconque croit en lui ait la vie éternelle."},
    {n:16, text:"Car Dieu a tant aimé le monde qu'il a donné son Fils unique, afin que quiconque croit en lui ne périsse point, mais qu'il ait la vie éternelle."},
    {n:17, text:"Dieu, en effet, n'a pas envoyé son Fils dans le monde pour qu'il juge le monde, mais pour que le monde soit sauvé par lui."},
    {n:18, text:"Celui qui croit en lui n'est point jugé ; mais celui qui ne croit pas est déjà jugé, parce qu'il n'a pas cru au nom du Fils unique de Dieu."},
    {n:19, text:"Et le jugement, c'est que la lumière est venue dans le monde, et que les hommes ont mieux aimé les ténèbres que la lumière, parce que leurs œuvres étaient mauvaises."},
    {n:20, text:"Car quiconque fait des choses mauvaises hait la lumière, et ne vient pas à la lumière, de peur que ses œuvres ne soient découvertes."},
    {n:21, text:"Mais celui qui pratique la vérité vient à la lumière, afin que ses œuvres soient manifestées, parce qu'elles sont faites en Dieu."},
    {n:22, text:"Après cela, Jésus alla dans le pays de Judée, avec ses disciples ; il y demeurait avec eux, et il baptisait."},
    {n:23, text:"Jean aussi baptisait à Aenon, près de Salim, parce qu'il y avait là beaucoup d'eau ; et on venait et on était baptisé."},
    {n:24, text:"Jean, en effet, n'avait pas encore été mis en prison."},
    {n:25, text:"Il s'éleva une discussion entre les disciples de Jean et un Juif, au sujet de la purification."},
    {n:26, text:"Ils vinrent auprès de Jean et lui dirent : Rabbi, celui qui était avec toi au delà du Jourdain, et à qui tu as rendu témoignage, voici qu'il baptise, et tous vont à lui."},
    {n:27, text:"Jean répondit : Un homme ne peut rien recevoir, à moins que cela ne lui ait été donné du ciel."},
    {n:28, text:"Vous-mêmes m'êtes témoins que j'ai dit : Je ne suis pas le Christ, mais j'ai été envoyé devant lui."},
    {n:29, text:"Celui à qui l'épouse appartient, c'est l'époux ; mais l'ami de l'époux, qui se tient là et qui l'entend, est tout joyeux de la voix de l'époux : telle est ma joie ; elle est complète."},
    {n:30, text:"Il faut qu'il croisse, et que je diminue."},
    {n:31, text:"Celui qui vient d'en haut est au-dessus de tous. Celui qui est de la terre est terrestre, et parle de la terre. Celui qui vient du ciel est au-dessus de tous."},
    {n:32, text:"Il atteste ce qu'il a vu et entendu, et personne ne reçoit son témoignage."},
    {n:33, text:"Celui qui a reçu son témoignage a certifié que Dieu est vrai."},
    {n:34, text:"Car celui que Dieu a envoyé dit les paroles de Dieu ; et Dieu ne lui donne pas l'Esprit avec mesure."},
    {n:35, text:"Le Père aime le Fils, et il a tout remis dans sa main."},
    {n:36, text:"Celui qui croit au Fils a la vie éternelle ; mais celui qui ne croit pas au Fils ne verra point la vie, mais la colère de Dieu demeure sur lui."}
  ],
  "Ps-23": [
    {n:1, text:"L'Éternel est mon berger : je ne manquerai de rien."},
    {n:2, text:"Il me fait reposer dans de verts pâturages, il me dirige près des eaux paisibles."},
    {n:3, text:"Il restaure mon âme, il me conduit dans les sentiers de la justice, à cause de son nom."},
    {n:4, text:"Quand je marche dans la vallée de l'ombre de la mort, je ne crains aucun mal, car tu es avec moi : ta houlette et ton bâton me rassurent."},
    {n:5, text:"Tu dresses devant moi une table, en face de mes adversaires ; tu oins d'huile ma tête, et ma coupe déborde."},
    {n:6, text:"Oui, le bonheur et la grâce m'accompagneront tous les jours de ma vie, et j'habiterai dans la maison de l'Éternel jusqu'à la fin de mes jours."}
  ],
  "Rm-8": [
    {n:1, text:"Il n'y a donc maintenant aucune condamnation pour ceux qui sont en Jésus-Christ."},
    {n:2, text:"En effet, la loi de l'Esprit de vie en Jésus-Christ m'a affranchi de la loi du péché et de la mort."},
    {n:3, text:"Car, chose impossible à la loi, parce que la chair la rendait sans force, Dieu a condamné le péché dans la chair en envoyant, à cause du péché, son propre Fils dans une chair semblable à celle du péché,"},
    {n:4, text:"afin que la justice de la loi fût accomplie en nous, qui marchons, non selon la chair, mais selon l'Esprit."},
    {n:5, text:"En effet, ceux qui vivent selon la chair s'affectionnent aux choses de la chair, tandis que ceux qui vivent selon l'Esprit s'affectionnent aux choses de l'Esprit."},
    {n:6, text:"Et l'affection de la chair, c'est la mort, tandis que l'affection de l'Esprit, c'est la vie et la paix."},
    {n:7, text:"Car l'affection de la chair est inimitié contre Dieu, parce qu'elle ne se soumet pas à la loi de Dieu et qu'elle ne le peut même pas."},
    {n:8, text:"Et ceux qui vivent selon la chair ne peuvent pas plaire à Dieu."},
    {n:9, text:"Pour vous, vous ne vivez pas selon la chair, mais selon l'Esprit, si du moins l'Esprit de Dieu habite en vous. Si quelqu'un n'a pas l'Esprit de Christ, il ne lui appartient pas."},
    {n:10, text:"Et si Christ est en vous, le corps, il est vrai, est mort à cause du péché, mais l'esprit est vivant à cause de la justice."},
    {n:11, text:"Et si l'Esprit de celui qui a ressuscité Jésus d'entre les morts habite en vous, celui qui a ressuscité Christ d'entre les morts rendra aussi la vie à vos corps mortels par son Esprit qui habite en vous."},
    {n:12, text:"Ainsi donc, frères, nous ne sommes pas débiteurs envers la chair, pour vivre selon la chair."},
    {n:13, text:"Si vous vivez selon la chair, vous mourrez ; mais si par l'Esprit vous faites mourir les actions du corps, vous vivrez."},
    {n:14, text:"Car tous ceux qui sont conduits par l'Esprit de Dieu sont fils de Dieu."},
    {n:15, text:"Et vous n'avez pas reçu un esprit de servitude, pour être encore dans la crainte ; mais vous avez reçu un esprit d'adoption, par lequel nous crions : Abba ! Père !"},
    {n:16, text:"L'Esprit lui-même rend témoignage à notre esprit que nous sommes enfants de Dieu."},
    {n:17, text:"Et si nous sommes enfants, nous sommes aussi héritiers ; héritiers de Dieu, et cohéritiers de Christ, si toutefois nous souffrons avec lui, afin d'être glorifiés avec lui."},
    {n:18, text:"J'estime que les souffrances du temps présent ne sauraient être comparées à la gloire à venir qui sera révélée pour nous."},
    {n:28, text:"Nous savons, du reste, que toutes choses concourent au bien de ceux qui aiment Dieu, de ceux qui sont appelés selon son dessein."},
    {n:29, text:"Car ceux qu'il a connus d'avance, il les a aussi prédestinés à être semblables à l'image de son Fils, afin que son Fils fût le premier-né entre plusieurs frères."},
    {n:31, text:"Que dirons-nous donc à ces choses ? Si Dieu est pour nous, qui sera contre nous ?"},
    {n:32, text:"Lui qui n'a point épargné son propre Fils, mais qui l'a livré pour nous tous, comment ne nous donnera-t-il pas aussi toutes choses avec lui ?"},
    {n:37, text:"Mais dans toutes ces choses nous sommes plus que vainqueurs par celui qui nous a aimés."},
    {n:38, text:"Car j'ai l'assurance que ni la mort ni la vie, ni les anges ni les principautés ni les puissances, ni les choses présentes ni les choses à venir,"},
    {n:39, text:"ni ce qui est en haut ni ce qui est en bas, ni aucune autre créature, ne pourra nous séparer de l'amour de Dieu manifesté en Jésus-Christ notre Seigneur."}
  ],
  "Ph-4": [
    {n:1, text:"Ainsi donc, mes frères bien-aimés et désirés, vous ma joie et ma couronne, tenez ferme dans le Seigneur, mes bien-aimés !"},
    {n:4, text:"Réjouissez-vous toujours dans le Seigneur ; je le dis encore, réjouissez-vous."},
    {n:5, text:"Que votre douceur soit connue de tous les hommes. Le Seigneur est proche."},
    {n:6, text:"Ne vous inquiétez de rien ; mais en toute chose faites connaître vos besoins à Dieu par des prières et des supplications, avec des actions de grâces."},
    {n:7, text:"Et la paix de Dieu, qui surpasse toute intelligence, gardera vos cœurs et vos pensées en Jésus-Christ."},
    {n:8, text:"Au reste, frères, que tout ce qui est vrai, tout ce qui est honnête, tout ce qui est juste, tout ce qui est pur, tout ce qui est aimable, tout ce qui mérite l'approbation, ce qui est vertueux et digne de louange, soit l'objet de vos pensées."},
    {n:11, text:"Ce n'est pas que je recherche les dons ; mais je recherche le fruit qui abonde pour votre compte."},
    {n:13, text:"Je puis tout par celui qui me fortifie."},
    {n:19, text:"Et mon Dieu pourvoira à tous vos besoins selon sa richesse, avec gloire, en Jésus-Christ."}
  ],
  "Jr-29": [
    {n:11, text:"Car je connais les projets que j'ai formés sur vous, dit l'Éternel, projets de paix et non de malheur, afin de vous donner un avenir et de l'espérance."},
    {n:12, text:"Vous m'invoquerez, et vous partirez ; vous me prierez, et je vous exaucerai."},
    {n:13, text:"Vous me chercherez, et vous me trouverez, si vous me cherchez de tout votre cœur."}
  ],
  "Ep-2": [
    {n:1, text:"Vous étiez morts par vos offenses et par vos péchés,"},
    {n:4, text:"Mais Dieu, qui est riche en miséricorde, à cause du grand amour dont il nous a aimés,"},
    {n:5, text:"nous a rendus vivants avec Christ, alors que nous étions morts par nos offenses, — c'est par grâce que vous êtes sauvés ;"},
    {n:6, text:"il nous a ressuscités ensemble, et nous a fait asseoir ensemble dans les lieux célestes en Jésus-Christ,"},
    {n:8, text:"Car c'est par la grâce que vous êtes sauvés, par le moyen de la foi. Et cela ne vient pas de vous, c'est le don de Dieu."},
    {n:9, text:"Ce n'est point par les œuvres, afin que personne ne se glorifie."},
    {n:10, text:"Car nous sommes son ouvrage, ayant été créés en Jésus-Christ pour de bonnes œuvres, que Dieu a préparées d'avance, afin que nous les pratiquions."}
  ]
};


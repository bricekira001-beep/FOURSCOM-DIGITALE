// ════════════════════════════════
// STATE
// ════════════════════════════════
let state = {
  book: "Jn", chapter: 3, version: "ls",
  selectedVerse: null, fontSize: 1.15,
  favorites: JSON.parse(localStorage.getItem('bible_favorites') || '[]'),
  history: JSON.parse(localStorage.getItem('bible_history') || '[]'),
  notes: JSON.parse(localStorage.getItem('bible_notes') || '{}'),
  highlights: JSON.parse(localStorage.getItem('bible_highlights') || '{}'),
  readChapters: JSON.parse(localStorage.getItem('bible_read_chapters') || '[]'),
  planDone: JSON.parse(localStorage.getItem('bible_plan_done') || '[]'),
  dark: localStorage.getItem('bible_dark') === '1'
};

let audioPlaying = false, audioSec = 0, audioInterval = null;
let activePanel = 'books';
let sidebarOpen = window.innerWidth > 768;

// ════════════════════════════════
// INIT
// ════════════════════════════════
window.addEventListener('load', () => {
  if (state.dark) document.body.classList.add('dark-mode');
  if (!sidebarOpen) document.getElementById('sidebar').classList.add('collapsed');
  renderReader();
  renderSidePanel();
});

// ════════════════════════════════
// READER
// ════════════════════════════════
function getVerses(book, ch) {
  const key = `${book}-${ch}`;
  if (VERSE_DB[key]) return VERSE_DB[key];
  // Generate placeholder verses for books not in DB
  const count = Math.floor(Math.random() * 20) + 10;
  const b = ALL_BOOKS.find(bk => bk.id === book);
  const placeholderTexts = [
    "Et l'Éternel dit à son peuple : Soyez forts et courageux, car je suis avec vous partout où vous allez.",
    "Alors les fils d'Israël levèrent les yeux et virent que la gloire de l'Éternel paraissait dans la nuée.",
    "Ce jour-là, le Seigneur éleva sa main puissante et fit des prodiges au milieu de son peuple.",
    "Et Moïse dit au peuple : Ne craignez point ; tenez vous en repos, et regardez la délivrance que l'Éternel va opérer pour vous aujourd'hui.",
    "L'Éternel combattra pour vous ; et vous, gardez le silence.",
    "Que vos paroles soient toujours accompagnées de grâce, assaisonnées de sel, afin que vous sachiez comment il faut répondre à chacun.",
    "Ainsi donc, ne soyez pas inconsidérés, mais comprenez quelle est la volonté du Seigneur.",
    "Et tout ce que vous faites, en parole ou en œuvre, faites tout au nom du Seigneur Jésus, en rendant par lui des actions de grâces à Dieu le Père.",
    "Cherchez les choses d'en haut, où Christ est assis à la droite de Dieu.",
    "Revêtez-vous donc, comme des élus de Dieu, saints et bien-aimés, de tendres miséricordes, de bienveillance, d'humilité, de douceur, de longanimité."
  ];
  const verses = [];
  for (let i = 1; i <= count; i++) {
    verses.push({ n: i, text: placeholderTexts[(i - 1) % placeholderTexts.length] });
  }
  return verses;
}

function getCurrentBook() {
  return ALL_BOOKS.find(b => b.id === state.book) || ALL_BOOKS[0];
}

function renderReader() {
  const book = getCurrentBook();
  const verses = getVerses(state.book, state.chapter);
  const vdj = VERSET_DU_JOUR_DATA[new Date().getDay()];
  const refKey = `${state.book}-${state.chapter}`;
  
  document.getElementById('currentRef').textContent = `${book.nom} ${state.chapter}`;
  document.title = `${book.nom} ${state.chapter} — Bible`;
  
  // Track history
  const histEntry = { book: state.book, chapter: state.chapter, bookName: book.nom, time: new Date().toISOString() };
  state.history = [histEntry, ...state.history.filter(h => !(h.book === state.book && h.chapter === state.chapter))].slice(0, 20);
  localStorage.setItem('bible_history', JSON.stringify(state.history));

  // Mark as read
  if (!state.readChapters.includes(refKey)) {
    state.readChapters.push(refKey);
    localStorage.setItem('bible_read_chapters', JSON.stringify(state.readChapters));
  }

  const showVDJ = state.book === 'Jn' && state.chapter === 3;

  const reader = document.getElementById('reader');
  reader.innerHTML = `
    ${showVDJ ? `
    <div class="verset-du-jour-banner">
      <div class="vdj-decoration"></div>
      <div class="vdj-label">✦ Verset du jour</div>
      <div class="vdj-text">${vdj.text}</div>
      <div class="vdj-ref">— ${vdj.ref}</div>
      <div style="margin-top:12px; display:flex; gap:8px; justify-content:center; flex-wrap:wrap;">
        <button onclick="copyText('${vdj.text.replace(/'/g,"\\'")} — ${vdj.ref}')" style="padding:7px 16px; border:1px solid var(--border-strong); border-radius:20px; background:transparent; cursor:pointer; font-family:var(--font); font-size:0.78rem; font-weight:700; color:var(--text-muted);">📋 Copier</button>
        <button onclick="shareTextWA('${vdj.text.replace(/'/g,"\\'")} — ${vdj.ref}')" style="padding:7px 16px; border:1px solid var(--border-strong); border-radius:20px; background:transparent; cursor:pointer; font-family:var(--font); font-size:0.78rem; font-weight:700; color:var(--text-muted);">💬 WhatsApp</button>
        <button onclick="rotateVDJ()" style="padding:7px 16px; border:none; border-radius:20px; background:var(--blue); color:white; cursor:pointer; font-family:var(--font); font-size:0.78rem; font-weight:700;">→ Suivant</button>
      </div>
    </div>` : ''}
    <div class="chapter-header">
      <div class="chapter-book">${book.nom} · Chapitre ${state.chapter}</div>
      <div class="chapter-num" style="font-size:${state.fontSize * 2.4}rem">${state.chapter}</div>
    </div>
    <div class="verse-list" id="verseList">
      ${verses.map((v, idx) => {
        const vKey = `${state.book}-${state.chapter}-${v.n}`;
        const hl = state.highlights[vKey];
        const isFav = state.favorites.some(f => f.key === vKey);
        const note = state.notes[vKey];
        const hlStyle = hl ? `background:${hl}33; border-left:3px solid ${hl}; padding-left:13px; margin-left:-7px;` : '';
        return `
        <div class="verse-row ${isFav ? 'favorited' : ''}" id="vrow-${v.n}" onclick="selectVerse(${v.n}, event)" style="${hlStyle}animation-delay:${idx * 0.025}s">
          <span class="verse-num">${v.n}</span>
          <div style="flex:1">
            <span class="verse-text" style="font-size:${state.fontSize}rem">${v.text}</span>
            ${note ? `<div class="verse-note">📝 ${note}</div>` : ''}
          </div>
          ${isFav ? '<i class="bx bx-heart" style="color:var(--red);font-size:0.9rem;margin-top:4px;flex-shrink:0"></i>' : ''}
        </div>`;
      }).join('')}
    </div>
    <div style="height:60px"></div>
  `;
  
  document.getElementById('audioRefText').textContent = `${book.nom} ${state.chapter} — ${VERSIONS[state.version]}`;
}

function navigate(dir) {
  const book = getCurrentBook();
  let ch = state.chapter + dir;
  let bookIdx = ALL_BOOKS.findIndex(b => b.id === state.book);
  if (ch < 1) {
    if (bookIdx > 0) { bookIdx--; state.book = ALL_BOOKS[bookIdx].id; ch = ALL_BOOKS[bookIdx].chapters; }
    else { ch = 1; }
  } else if (ch > book.chapters) {
    if (bookIdx < ALL_BOOKS.length - 1) { bookIdx++; state.book = ALL_BOOKS[bookIdx].id; ch = 1; }
    else { ch = book.chapters; }
  }
  state.chapter = ch;
  state.selectedVerse = null;
  closePopup();
  renderReader();
  renderSidePanel();
  document.getElementById('reader').scrollTop = 0;
}

function goTo(bookId, ch) {
  state.book = bookId;
  state.chapter = ch;
  state.selectedVerse = null;
  closePopup();
  renderReader();
  if (window.innerWidth <= 768) document.getElementById('sidebar').classList.add('collapsed');
  document.getElementById('reader').scrollTop = 0;
}

function changeVersion(v) {
  state.version = v;
  showToast(`Version changée : ${VERSIONS[v]}`);
  renderReader();
}

let vdjIdx = 0;
function rotateVDJ() {
  vdjIdx = (vdjIdx + 1) % VERSET_DU_JOUR_DATA.length;
  // Re-render banner only
  const banner = document.querySelector('.verset-du-jour-banner');
  if (banner) {
    const vdj = VERSET_DU_JOUR_DATA[vdjIdx];
    banner.querySelector('.vdj-text').textContent = vdj.text;
    banner.querySelector('.vdj-ref').textContent = `— ${vdj.ref}`;
  }
}

function adjustFont(dir) {
  state.fontSize = Math.max(0.85, Math.min(1.6, state.fontSize + dir * 0.1));
  document.querySelectorAll('.verse-text').forEach(el => el.style.fontSize = state.fontSize + 'rem');
  document.querySelector('.chapter-num').style.fontSize = (state.fontSize * 2.4) + 'rem';
}

// ════════════════════════════════
// VERSE SELECTION
// ════════════════════════════════
function selectVerse(n, e) {
  e.stopPropagation();
  state.selectedVerse = n;
  const popup = document.getElementById('versePopup');
  const vKey = `${state.book}-${state.chapter}-${n}`;
  const isFav = state.favorites.some(f => f.key === vKey);
  document.getElementById('favBtnIcon').className = isFav ? 'bx bx-heart-circle' : 'bx bx-heart';
  document.getElementById('favBtnText').textContent = isFav ? 'Retirer des favoris' : 'Ajouter aux favoris';
  const x = Math.min(e.clientX, window.innerWidth - 200);
  const y = Math.min(e.clientY + 10, window.innerHeight - 260);
  popup.style.left = x + 'px';
  popup.style.top = y + 'px';
  popup.classList.add('open');
}

document.addEventListener('click', e => {
  if (!e.target.closest('.verse-popup') && !e.target.closest('.verse-row')) closePopup();
});

function closePopup() {
  document.getElementById('versePopup').classList.remove('open');
}

function getSelectedVerseData() {
  if (!state.selectedVerse) return null;
  const verses = getVerses(state.book, state.chapter);
  return verses.find(v => v.n === state.selectedVerse);
}

function getSelectedRef() {
  const book = getCurrentBook();
  return `${book.nom} ${state.chapter}:${state.selectedVerse}`;
}

function copyVerse() {
  const v = getSelectedVerseData();
  if (!v) return;
  const text = `"${v.text}" — ${getSelectedRef()} (${VERSIONS[state.version]})`;
  navigator.clipboard.writeText(text).catch(()=>{});
  showToast('Verset copié !');
  closePopup();
}

function shareVerse() {
  const v = getSelectedVerseData();
  if (!v) return;
  const text = encodeURIComponent(`"${v.text}" — ${getSelectedRef()} 📖`);
  window.open(`https://wa.me/?text=${text}`, '_blank');
  closePopup();
}

function toggleFavorite() {
  if (!state.selectedVerse) return;
  const v = getSelectedVerseData();
  const book = getCurrentBook();
  const vKey = `${state.book}-${state.chapter}-${state.selectedVerse}`;
  const idx = state.favorites.findIndex(f => f.key === vKey);
  if (idx >= 0) {
    state.favorites.splice(idx, 1);
    showToast('Retiré des favoris');
  } else {
    state.favorites.unshift({ key: vKey, ref: getSelectedRef(), text: v.text, bookName: book.nom, book: state.book, chapter: state.chapter, verse: state.selectedVerse });
    showToast('Ajouté aux favoris ❤️');
  }
  localStorage.setItem('bible_favorites', JSON.stringify(state.favorites));
  closePopup();
  renderReader();
  if (activePanel === 'favs') renderSidePanel();
}

function highlightVerse(color) {
  if (!state.selectedVerse) return;
  const vKey = `${state.book}-${state.chapter}-${state.selectedVerse}`;
  const colorMap = { yellow: '#FFD23C', green: '#14A46C', blue: '#0066B3', red: '#D9152B' };
  state.highlights[vKey] = colorMap[color] || colorMap.yellow;
  localStorage.setItem('bible_highlights', JSON.stringify(state.highlights));
  closePopup();
  renderReader();
  showToast('Passage surligné !');
}

function removeHighlight() {
  if (!state.selectedVerse) return;
  const vKey = `${state.book}-${state.chapter}-${state.selectedVerse}`;
  delete state.highlights[vKey];
  localStorage.setItem('bible_highlights', JSON.stringify(state.highlights));
  closePopup();
  renderReader();
}

// ════════════════════════════════
// NOTES
// ════════════════════════════════
function openNote() {
  const v = getSelectedVerseData();
  if (!v) return;
  const vKey = `${state.book}-${state.chapter}-${state.selectedVerse}`;
  document.getElementById('noteRef').textContent = getSelectedRef();
  document.getElementById('noteVerseText').textContent = v.text;
  document.getElementById('noteTextarea').value = state.notes[vKey] || '';
  document.getElementById('noteModal').classList.add('open');
  closePopup();
}

function closeNote() { document.getElementById('noteModal').classList.remove('open'); }

function saveNote() {
  const vKey = `${state.book}-${state.chapter}-${state.selectedVerse}`;
  const text = document.getElementById('noteTextarea').value.trim();
  if (text) { state.notes[vKey] = text; showToast('Note enregistrée !'); }
  else { delete state.notes[vKey]; showToast('Note supprimée'); }
  localStorage.setItem('bible_notes', JSON.stringify(state.notes));
  closeNote();
  renderReader();
}

// ════════════════════════════════
// AUDIO
// ════════════════════════════════
function openAudioPlayer() {
  document.getElementById('audioBar').classList.add('active');
}

function closeAudio() {
  clearInterval(audioInterval);
  audioPlaying = false;
  audioSec = 0;
  document.getElementById('audioBar').classList.remove('active');
  document.getElementById('audioPF').style.width = '0%';
  document.getElementById('audioIcon').className = 'bx bx-play';
}

function toggleAudio() {
  audioPlaying = !audioPlaying;
  document.getElementById('audioIcon').className = audioPlaying ? 'bx bx-pause' : 'bx bx-play';
  if (audioPlaying) {
    const duration = getVerses(state.book, state.chapter).length * 8;
    audioInterval = setInterval(() => {
      audioSec++;
      const pct = (audioSec / duration) * 100;
      document.getElementById('audioPF').style.width = Math.min(pct, 100) + '%';
      const m = Math.floor(audioSec / 60), s = audioSec % 60;
      document.getElementById('audioTimeTxt').textContent = `${m}:${String(s).padStart(2,'0')}`;
      if (audioSec >= duration) { audioPlaying = false; clearInterval(audioInterval); document.getElementById('audioIcon').className = 'bx bx-play'; audioSec = 0; }
    }, 1000);
  } else {
    clearInterval(audioInterval);
  }
}

function seekAudio(e, bar) {
  const pct = (e.clientX - bar.getBoundingClientRect().left) / bar.offsetWidth;
  const duration = getVerses(state.book, state.chapter).length * 8;
  audioSec = Math.round(pct * duration);
  document.getElementById('audioPF').style.width = (pct * 100) + '%';
}

function listenVerse() {
  closePopup();
  openAudioPlayer();
  if (!audioPlaying) toggleAudio();
  showToast('Lecture audio en cours…');
}

// ════════════════════════════════
// SIDEBAR
// ════════════════════════════════
function toggleSidebar() {
  const sb = document.getElementById('sidebar');
  sb.classList.toggle('collapsed');
  sidebarOpen = !sb.classList.contains('collapsed');
}

function showSidePanel(panel, btn) {
  activePanel = panel;
  document.querySelectorAll('.stab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderSidePanel();
}

function renderSidePanel() {
  const body = document.getElementById('sideBody');
  if (activePanel === 'books') {
    body.innerHTML = `
      <div class="testament-group">
        <div class="testament-label">Ancien Testament (39)</div>
        <div class="book-grid">${BOOKS.at.map(b => `<button class="book-btn ${b.id === state.book ? 'active' : ''}" onclick="selectBook('${b.id}')">${b.nom.length > 10 ? b.nom.substring(0,8)+'…' : b.nom}</button>`).join('')}</div>
      </div>
      <div class="testament-group">
        <div class="testament-label">Nouveau Testament (27)</div>
        <div class="book-grid">${BOOKS.nt.map(b => `<button class="book-btn ${b.id === state.book ? 'active' : ''}" onclick="selectBook('${b.id}')">${b.nom.length > 10 ? b.nom.substring(0,8)+'…' : b.nom}</button>`).join('')}</div>
      </div>`;
  } else if (activePanel === 'chapters') {
    const book = getCurrentBook();
    body.innerHTML = `
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
        <button onclick="showSidePanel('books',document.querySelector('.stab'))" style="border:none;background:none;cursor:pointer;color:var(--blue);font-size:0.8rem;font-weight:800;font-family:var(--font)">← Livres</button>
        <span style="font-weight:900;color:var(--text)">${book.nom}</span>
      </div>
      <div class="chapter-grid">
        ${Array.from({length: book.chapters}, (_,i) => {
          const refKey = `${state.book}-${i+1}`;
          const isRead = state.readChapters.includes(refKey);
          return `<button class="ch-btn ${state.chapter === i+1 ? 'active' : ''} ${isRead ? 'read' : ''}" onclick="goTo('${state.book}', ${i+1})">${i+1}</button>`;
        }).join('')}
      </div>`;
  } else if (activePanel === 'favs') {
    if (!state.favorites.length) {
      body.innerHTML = '<div style="text-align:center;padding:2rem 1rem;color:var(--text-muted);font-size:0.85rem"><i class="bx bx-heart" style="font-size:2rem;display:block;margin-bottom:8px"></i>Aucun favori.<br>Sélectionnez un verset et cliquez ❤️</div>';
    } else {
      body.innerHTML = state.favorites.map(f => `
        <div class="fav-item" onclick="goTo('${f.book}', ${f.chapter})">
          <div class="fav-ref">${f.ref}</div>
          <div class="fav-text">${f.text.substring(0,90)}${f.text.length > 90 ? '…' : ''}</div>
        </div>`).join('');
    }
  } else if (activePanel === 'history') {
    if (!state.history.length) {
      body.innerHTML = '<div style="text-align:center;padding:2rem 1rem;color:var(--text-muted);font-size:0.85rem">Aucun historique de lecture.</div>';
    } else {
      body.innerHTML = state.history.map(h => `
        <div class="hist-item" onclick="goTo('${h.book}', ${h.chapter})">
          <div class="hist-ref">${h.bookName} ${h.chapter}</div>
          <div class="hist-time">${formatHistTime(h.time)}</div>
        </div>`).join('');
    }
  } else if (activePanel === 'plan') {
    body.innerHTML = READING_PLANS.map((p, i) => `
      <div class="plan-item ${state.planDone.includes(i) ? 'done' : ''}" onclick="startPlan(${i})">
        <div class="plan-day">${p.day} ${state.planDone.includes(i) ? '✓' : ''}</div>
        <div class="plan-ref">${p.ref}</div>
        <div class="plan-desc">${p.desc}</div>
      </div>`).join('');
  }
}

function selectBook(bookId) {
  state.book = bookId;
  state.chapter = 1;
  activePanel = 'chapters';
  renderSidePanel();
  renderReader();
}

function startPlan(idx) {
  const p = READING_PLANS[idx];
  goTo(p.book, p.ch);
  if (!state.planDone.includes(idx)) {
    state.planDone.push(idx);
    localStorage.setItem('bible_plan_done', JSON.stringify(state.planDone));
  }
  renderSidePanel();
}

function formatHistTime(iso) {
  const d = new Date(iso);
  const diff = Date.now() - d;
  const min = Math.floor(diff / 60000);
  if (min < 1) return 'À l\'instant';
  if (min < 60) return `Il y a ${min} min`;
  if (min < 1440) return `Il y a ${Math.floor(min/60)} h`;
  return d.toLocaleDateString('fr-FR', {day:'2-digit', month:'short'});
}

// ════════════════════════════════
// SEARCH
// ════════════════════════════════
function handleSearch(val) {
  const q = val.trim().toLowerCase();
  const res = document.getElementById('searchResults');
  if (!q) { res.classList.remove('open'); return; }

  // Check if it's a book:chapter reference
  const refMatch = val.match(/^([a-zA-ZÀ-ÿ\s]+)\s*(\d+):?(\d*)/i);
  const results = [];

  VERSE_SEARCH_INDEX.forEach(item => {
    if (item.ref.toLowerCase().includes(q) || item.text.toLowerCase().includes(q)) results.push(item);
  });

  if (refMatch) {
    const bookQuery = refMatch[1].trim().toLowerCase();
    ALL_BOOKS.forEach(b => {
      if (b.nom.toLowerCase().startsWith(bookQuery) || b.id.toLowerCase().startsWith(bookQuery)) {
        const ch = parseInt(refMatch[2]) || 1;
        if (ch <= b.chapters) results.unshift({ ref: `${b.nom} ${ch}`, book: b.id, ch, v: null, text: `Aller à ${b.nom} chapitre ${ch}` });
      }
    });
  }

  const unique = [...new Map(results.map(r => [r.ref, r])).values()].slice(0, 8);
  if (!unique.length) { res.innerHTML = '<div class="sr-item" style="color:var(--text-muted)">Aucun résultat</div>'; res.classList.add('open'); return; }
  
  res.innerHTML = unique.map(r => `<div class="sr-item" onclick="goToSearchResult('${r.book}', ${r.ch || 1})"><span class="sr-ref">${r.ref}</span>${r.text.substring(0, 60)}…</div>`).join('');
  res.classList.add('open');
}

function goToSearchResult(book, ch) {
  goTo(book, ch);
  document.getElementById('searchInput').value = '';
  closeSearch();
}

function closeSearch() { document.getElementById('searchResults').classList.remove('open'); }

// ════════════════════════════════
// UTILITIES
// ════════════════════════════════
function copyText(text) {
  navigator.clipboard.writeText(text).catch(()=>{});
  showToast('Copié !');
}

function shareTextWA(text) {
  window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
}

function toggleDark() {
  document.body.classList.toggle('dark-mode');
  state.dark = document.body.classList.contains('dark-mode');
  localStorage.setItem('bible_dark', state.dark ? '1' : '0');
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}
</script>
</body>
</html>